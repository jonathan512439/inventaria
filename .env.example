# URL pública de la app (los enlaces de los correos de confirmación apuntan aquí)
NEXT_PUBLIC_APP_URL=https://inventaria.pages.dev

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo backend, NUNCA exponer al cliente
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini (https://aistudio.google.com/apikey) ---
# Solo backend, NUNCA exponer al cliente
GEMINI_API_KEY=
# Opcional: modelo Flash a usar. Por defecto gemini-3.6-flash (alternativas: gemini-3.5-flash-lite, gemini-flash-latest)
GEMINI_MODEL=gemini-3.6-flash
# Opcional: modelos de respaldo (el cupo gratuito es por modelo y por día)
GEMINI_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-flash-latest

# --- Solo para scripts de despliegue local (scripts/*.mjs), NO los usa la app ---
# Cloudflare: token con permiso "Cloudflare Pages: Edit" + Account ID
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=inventaria
# Supabase: token personal (Account > Access Tokens) para ejecutar SQL con scripts/supabase-sql.mjs
SUPABASE_ACCESS_TOKEN=
